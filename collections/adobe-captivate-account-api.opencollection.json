{
  "opencollection": "1.0.0",
  "info": {
    "name": "Adobe Captivate Prime API (Learning Manager) Account API",
    "version": "2"
  },
  "request": {
    "auth": {
      "type": "oauth2",
      "flow": "client_credentials",
      "accessTokenUrl": "https://learningmanager.adobe.com/oauth/token",
      "credentials": {
        "clientId": "{{clientId}}",
        "clientSecret": "{{clientSecret}}"
      }
    }
  },
  "items": [
    {
      "info": {
        "name": "Account",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Adobe Captivate Get Account Details",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://learningmanager.adobe.com/primeapi/v2/account"
          },
          "docs": "Retrieves the account configuration and details for the authenticated user's Learning Manager account, including timezone, locale, and enabled features."
        }
      ]
    }
  ],
  "bundled": true
}